{
  "name": "stash",
  "version": "0.2.3",
  "description": "Minimal clipboard history with drag-and-drop to any app",
  "main": "src/main.js",
  "author": "HariKrish",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "build:ocr": "node scripts/build-mac-ocr.js",
    "pack": "npm run build:ocr && electron-builder --dir",
    "dist": "npm run build:ocr && electron-builder",
    "dist:mac": "npm run build:ocr && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build:ocr && electron-builder --win --x64 --publish never",
    "build:shaders": "esbuild scripts/shader-entry.js --bundle --format=iife --global-name=PaperShaders --minify --target=chrome120 --outfile=src/vendor/paper-shaders.js"
  },
  "devDependencies": {
    "@paper-design/shaders": "^0.0.80",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.harikrish.stash",
    "productName": "Stash",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "sign/entitlements.mac.plist",
      "entitlementsInherit": "sign/entitlements.mac.inherit.plist",
      "notarize": true,
      "binaries": [
        "Contents/Resources/stash-ocr"
      ],
      "minimumSystemVersion": "10.15",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Stash needs this to press Command-V in the app you were last using, so a clip you pick can paste itself.",
        "NSDesktopFolderUsageDescription": "Stash watches where macOS saves your screenshots so they turn up in your clipboard history like anything else you copy.",
        "NSDocumentsFolderUsageDescription": "Stash only reads this if you have told macOS to save your screenshots here.",
        "NSDownloadsFolderUsageDescription": "Stash only reads this if you have told macOS to save your screenshots here."
      },
      "extraResources": [
        {
          "from": "build/mac/stash-ocr",
          "to": "stash-ocr"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "electronLanguages": [
        "en-US"
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "electronLanguages": [
        "en-US"
      ]
    },
    "files": [
      "src/**/*",
      "!src/_harness.html",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [],
    "publish": [
      {
        "provider": "github",
        "owner": "harikrsh10",
        "repo": "Stash"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
