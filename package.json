{
  "name": "stash",
  "version": "0.1.21",
  "description": "Minimal clipboard history with drag-and-drop to any app",
  "main": "src/main.js",
  "author": "HariKrish",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "build:ocr": "node scripts/build-mac-ocr.js",
    "pack": "npm run build:ocr && electron-builder --dir",
    "dist": "npm run build:ocr && electron-builder",
    "dist:mac": "npm run build:ocr && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build:ocr && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.harikrish.stash",
    "productName": "Stash",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "extraResources": [
        {
          "from": "build/mac/stash-ocr",
          "to": "stash-ocr"
        }
      ],
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": []
  }
}
