{
  "name": "stash",
  "version": "0.1.15",
  "description": "Minimal clipboard history with drag-and-drop to any app",
  "main": "src/main.js",
  "author": "HariKrish",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "tessdata": "node scripts/fetch-tessdata.js",
    "pack": "npm run tessdata && electron-builder --dir",
    "dist": "npm run tessdata && electron-builder",
    "dist:mac": "npm run tessdata && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run tessdata && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.harikrish.stash",
    "productName": "Stash",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "identity": null,
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "assets/tessdata/**"
    ]
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  }
}
